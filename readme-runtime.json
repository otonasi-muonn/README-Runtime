{
  "cards": [
    {
      "name": "mockcraft",
      "title": "mockcraft · editor auto-pilot",
      "wasm": "examples/mockcraft/logic.wasm",
      "build": {
        "command": "npx asc examples/mockcraft/logic.ts -O3 --runtime stub --noAssert -o examples/mockcraft/logic.wasm",
        "inputs": [
          "examples/mockcraft/logic.ts"
        ]
      },
      "export": "step",
      "init": 1536,
      "steps": 160,
      "stepMs": 150,
      "ui": {
        "entry": "examples/mockcraft/demo.tsx",
        "tsconfig": "examples/mockcraft/tsconfig.json",
        "css": [
          "examples/mockcraft/upstream/src/app/globals.css"
        ],
        "views": {
          "dx": "view_dx",
          "dy": "view_dy",
          "on": "view_on",
          "sel": "view_sel",
          "hits": "view_hits"
        },
        "credit": "UI reused from UIdesign@2f97712 (unchanged)"
      }
    },
    {
      "name": "collatz",
      "title": "Collatz conjecture",
      "wasm": "examples/collatz/collatz.wasm",
      "build": {
        "command": "node tools/cc-wasm.mjs examples/collatz/collatz.c examples/collatz/collatz.wasm",
        "inputs": [
          "examples/collatz/collatz.c",
          "tools/cc-wasm.mjs"
        ]
      },
      "export": "step",
      "init": 27,
      "altInits": [97, 871],
      "steps": 120,
      "halt": 1
    },
    {
      "name": "lfsr-rust",
      "title": "16-bit LFSR (Rust)",
      "wasm": "examples/lfsr-rust/lfsr.wasm",
      "build": {
        "command": "rustc --edition 2021 --crate-type cdylib --target wasm32-unknown-unknown -C opt-level=2 -C panic=abort -C strip=symbols -o examples/lfsr-rust/lfsr.wasm examples/lfsr-rust/lfsr.rs",
        "inputs": [
          "examples/lfsr-rust/lfsr.rs"
        ]
      },
      "export": "step",
      "init": 1,
      "steps": 120,
      "bits": 16
    },
    {
      "name": "air-drawing",
      "title": "air-drawing-board · replay",
      "wasm": "examples/air-drawing/logic.wasm",
      "build": {
        "command": "node examples/air-drawing/prepare.mjs && npx asc examples/air-drawing/logic.ts -O3 --runtime stub --noAssert -o examples/air-drawing/logic.wasm",
        "inputs": [
          "examples/air-drawing/prepare.mjs",
          "examples/air-drawing/logic.ts",
          "examples/air-drawing/upstream/src/codec/drawingCodec.ts",
          "examples/air-drawing/upstream/src/domain/drawing.ts",
          "examples/air-drawing/upstream/tests/fixtures/test-vectors-v1.json"
        ]
      },
      "export": "step",
      "init": 0,
      "steps": 177,
      "hold": 24,
      "stepMs": 50,
      "ui": {
        "entry": "examples/air-drawing/demo.tsx",
        "css": [
          "examples/air-drawing/upstream/src/styles.css"
        ],
        "views": {
          "k0": "view_k0",
          "k1": "view_k1",
          "k2": "view_k2",
          "k3": "view_k3",
          "col": "view_col",
          "wid": "view_wid",
          "n": "view_n",
          "pts": "view_pts"
        },
        "credit": "drawing + renderStroke() from air-drawing-board@d71f336 (unchanged)"
      }
    }
  ]
}
